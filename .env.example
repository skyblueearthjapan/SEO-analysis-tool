# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seo_analysis

# Google PageSpeed Insights API Key
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# OpenAI API Key (for AI report generation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative to OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Search Console credentials path
GSC_CREDENTIALS_PATH=./credentials/gsc_credentials.json

# Debug mode
DEBUG=true

# CORS origins (comma-separated if multiple)
CORS_ORIGINS=["http://localhost:3000"]
